# Copy to .env and fill in. Every variable is optional except EDENAI_API_KEY.

# --- Models (Eden AI, OpenAI-compatible API, open-weights models only) ---
# The only setting that must be set. Secret: only here, never commit it.
EDENAI_API_KEY=
LLM_BASE_URL=https://api.edenai.run/v3
# Planner (text in: the Markdown of the pages).
LLM_MODEL=deepinfra/zai-org/GLM-5.2
LLM_TIMEOUT_S=1200
# Reads every page image into Markdown, one call per page.
TRANSCRIBE_MODEL=deepinfra/Qwen/Qwen3.5-397B-A17B
TRANSCRIBE_SIDE=1024

# --- Upload ---
MAX_FILE_SIZE_MB=10

# --- Docker build only (docker compose reads it from .env) ---
# 1 (default) = LibreOffice in the image: DOC/DOCX/ODS/XLS/XLSX become page images. 0 = PDF and images only.
LIBREOFFICE=1
