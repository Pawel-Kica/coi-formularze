# Copy to .env and fill in. Every variable is optional except where noted.

# --- Upload ---
MAX_FILE_SIZE_MB=10

# --- Auth (JWT) ---
# Required in production (docker compose refuses to start without it), min 32 chars:
#   openssl rand -hex 32
JWT_SECRET=
# Login the API issues tokens for. Without AUTH_PASSWORD local login is off.
AUTH_USERNAME=admin
AUTH_PASSWORD=
JWT_ALGORITHM=HS256
JWT_ISSUER=coi-formularze
JWT_AUDIENCE=coi-formularze
JWT_TTL_MINUTES=60
# External identity provider instead of local tokens (e.g. Keycloak):
# JWT_JWKS_URL=https://sso.example.gov.pl/realms/coi/protocol/openid-connect/certs
# JWT_ALGORITHM=RS256
# JWT_ISSUER=https://sso.example.gov.pl/realms/coi
# JWT_AUDIENCE=coi-formularze

# --- Local model (Ollama) and OCR ---
LLM_URL=http://localhost:11434
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_TIMEOUT_S=900
# tesseract | vlm (vision model in Ollama reads scans)
OCR_ENGINE=tesseract
OCR_VLM_MODEL=qwen2.5vl:7b
