# Copy to .env and fill in. Every variable is optional except where noted.

# --- Upload ---
MAX_FILE_SIZE_MB=10
# Upload page history (SQLite). Docker: /tmp/history.sqlite3, in memory, gone on restart.
# HISTORY_DB=history.sqlite3
# 0 = the server keeps no uploaded file or result after the request (/api/history answers 404,
# the page's file list lasts until reload). The dictionary catalog stays (names and values only).
HISTORY_ENABLED=1

# --- Auth (JWT) ---
# 0 (default for now) = open API, no login on the pages. 1 = Bearer JWT required, the pages show the login.
AUTH_ENABLED=0
# With AUTH_ENABLED=1 set it in production, min 32 chars:
#   openssl rand -hex 32
JWT_SECRET=
# Login the API issues tokens for. Without AUTH_PASSWORD local login is off.
AUTH_USERNAME=admin
AUTH_PASSWORD=
JWT_ALGORITHM=HS256
JWT_ISSUER=coi-formularze
JWT_AUDIENCE=coi-formularze
JWT_TTL_MINUTES=60
# External identity provider instead of local tokens (e.g. Keycloak):
# JWT_JWKS_URL=https://sso.example.gov.pl/realms/coi/protocol/openid-connect/certs
# JWT_ALGORITHM=RS256
# JWT_ISSUER=https://sso.example.gov.pl/realms/coi
# JWT_AUDIENCE=coi-formularze

# --- Model that plans the form (any OpenAI-compatible chat API) ---
# ollama = local Ollama (no key; /v1 is added to the URL if missing)
# openai = remote OpenAI-compatible API, e.g. Eden AI (open-weights models only):
#   LLM_BACKEND=openai
#   LLM_BASE_URL=https://api.edenai.run/v3
#   LLM_MODEL=deepinfra/google/gemma-4-31B-it
#   (fallback model: deepinfra/Qwen/Qwen3.8-27B)
LLM_BACKEND=ollama
# Unset = http://localhost:11434/v1 natively, Ollama on the host under docker compose.
# Ollama container (docker compose --profile ollama): LLM_BASE_URL=http://ollama:11434/v1
# LLM_BASE_URL=
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_TIMEOUT_S=1200
# Bearer key for LLM_BACKEND=openai. Secret: only here, never commit it.
EDENAI_API_KEY=

# --- Vision (needs a vision model in LLM_MODEL, e.g. qwen3-vl:30b-a3b-instruct) ---
# 1 = PDF pages and JPG/PNG also go to the model as page images, next to the text.
# DOC/DOCX/XLS(X)/ODS stay text only. Qwen3-VL: ~1 token per 32x32 px (1400 px A4 page ~1.4k).
LLM_VISION=0
LLM_VISION_MAX_SIDE=1400
LLM_VISION_MAX_PAGES=8
# Pass 2 (conditions) gets smaller images; 0 = pass 2 text only.
LLM_VISION_CONDITIONS_SIDE=1024

# --- OCR ---
# tesseract | vlm (vision model in Ollama reads scans)
OCR_ENGINE=tesseract
# Model for OCR_ENGINE=vlm; empty = LLM_MODEL (then it must be a vision model)
OCR_VLM_MODEL=

# --- Docker build only (docker compose reads it from .env) ---
# 1 = LibreOffice in the image (DOC/DOCX/ODS/XLS/XLSX -> PDF), needed by PIPELINE=images.
LIBREOFFICE=0
